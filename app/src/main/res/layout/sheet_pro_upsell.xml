<?xml version="1.0" encoding="utf-8"?>
<!-- vc159: Da Vinci v1 section 5 upsell sheet (v1.1 copy + erratum, v1.2 one-time). Never opens on its own.
     vc160: Da Vinci Pro Gold v1 section 4.1 (gold rule, title, checks, CTA; 16sp lines) + 4.4 unlock panel overlay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pro_sheet"
    android:orientation="vertical">

    <View
        android:id="@+id/pro_sheet_rule"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="#FFD700" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/pro_sheet_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/pro_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/pro_sheet_title"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pro_sheet_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#C8D4DC"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pro_sheet_lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pro_sheet_lead"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableStart="@drawable/ic_pro_check_gold"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:text="@string/pro_sheet_item_past"
            android:textColor="#E8EEF4"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_pro_check_gold"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:text="@string/pro_sheet_item_replay"
            android:textColor="#E8EEF4"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_pro_check_gold"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:text="@string/pro_sheet_item_themes"
            android:textColor="#E8EEF4"
            android:textSize="16sp" />

        <!-- B6: unlimited live tracking item (ProUi swaps to pro_sheet_item_live_short past 2 lines). -->
        <TextView
            android:id="@+id/pro_sheet_item_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_pro_check_gold"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:text="@string/pro_sheet_item_live"
            android:textColor="#E8EEF4"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pro_sheet_included"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pro_sheet_included"
            android:textColor="#8AA0B0"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/pro_sheet_primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_pro_cta_gold"
                android:text="@string/pro_get"
                android:textAllCaps="false"
                android:textColor="#1A1200"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pro_sheet_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/pro_sheet_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_horizontal"
            android:text="@string/pro_confirm_one_time"
            android:textColor="#C8D4DC"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pro_sheet_not_now"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/pro_not_now"
                android:textAllCaps="false"
                android:textColor="#D0DCE8"
                android:textSize="16sp" />

            <Button
                android:id="@+id/pro_sheet_restore"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/pro_restore"
                android:textAllCaps="false"
                android:textColor="#D0DCE8"
                android:textSize="16sp" />

            <Button
                android:id="@+id/pro_sheet_try_again"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/pro_try_again"
                android:textAllCaps="false"
                android:textColor="#D0DCE8"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/pro_sheet_close"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/pro_close"
                android:textAllCaps="false"
                android:textColor="#D0DCE8"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_pro_unlock" />
    </FrameLayout>
</LinearLayout>
