<?xml version="1.0" encoding="utf-8"?>
<!-- vc159: Da Vinci v1 section 3 historic row (free users, HISTORIC list only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A1018"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/row_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8AA0B0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/row_pill"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pro_pill_included"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/pro_pill_included"
            android:textColor="#7CF0A8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_lock_zone"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:minWidth="48dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pro_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/pro_cd_badge"
            android:text="@string/pro_badge"
            android:textColor="#C8D4DC"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
