<?xml version="1.0" encoding="utf-8"?>
<!-- Stamp 69: ROS selected = LIT bright amber -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3A2808"/>
            <stroke android:width="2dp" android:color="#FFD080"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFB040"/>
            <corners android:radius="5dp"/>
        </shape>
    </item>
</layer-list>
