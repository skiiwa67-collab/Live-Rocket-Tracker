<?xml version="1.0" encoding="utf-8"?>
<!-- Stamp 69: CLEAR cyan selected = LIT bright fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#002028"/>
            <stroke android:width="2dp" android:color="#60F0FF"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00E5FF"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</layer-list>
