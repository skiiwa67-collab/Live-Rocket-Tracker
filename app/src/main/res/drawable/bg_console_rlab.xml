<?xml version="1.0" encoding="utf-8"?>
<!-- tip150: settings chrome — outer accent + inner plate (match MCC/ROS visibility) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101010"/>
            <stroke android:width="3dp" android:color="#FF5A1F"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#080606"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
</layer-list>
