@@ -0,0 +1,37 @@
+package com.claudewidgets.alarmweather
+
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Locale
+import java.util.TimeZone
+
+/**
+ * The format pattern handed to the CLOCK line's TextClock.
+ *
+ * TextClock renders these through android.text.format.DateFormat, which reads
+ * the same pattern letters as SimpleDateFormat - so [render] reproduces on the
+ * JVM exactly what the launcher will draw, which is what the tests assert on.
+ */
+object ClockFormat {
+
+    /** 00-23, so it can never reach 24. */
+    const val PATTERN_24H = "HH:mm:ss"
+
+    /** 01-12 zero-padded, so noon and midnight both read 12 rather than 00. */
+    const val PATTERN_12H = "hh:mm:ss"
+
+    fun pattern(use24h: Boolean): String = if (use24h) PATTERN_24H else PATTERN_12H
+
+    fun render(pattern: String, millis: Long, zone: TimeZone): String =
+        SimpleDateFormat(pattern, Locale.US).apply { timeZone = zone }.format(millis)
+
+    fun render(use24h: Boolean, millis: Long, zone: TimeZone): String =
+        render(pattern(use24h), millis, zone)
+
+    /** Local wall time -> epoch millis in [zone], for readable test cases. */
+    fun at(zone: TimeZone, year: Int, month1: Int, day: Int, hour: Int, minute: Int, second: Int): Long =
+        Calendar.getInstance(zone).apply {
+            clear()
+            set(year, month1 - 1, day, hour, minute, second)
+        }.timeInMillis
+}
