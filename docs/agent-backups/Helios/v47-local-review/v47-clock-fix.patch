+package com.claudewidgets.alarmweather
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import java.util.TimeZone
+
+/**
+ * The CLOCK line's four display rules, asserted against the same pattern letters
+ * TextClock hands to android.text.format.DateFormat:
+ *   - always six digits, zero padded
+ *   - 24h never reaches 24
+ *   - 12h shows 12 at noon and at midnight, never 00
+ *   - correct across midnight, noon and both DST shifts
+ */
+class ClockFormatTest {
+
+    private val central = TimeZone.getTimeZone("America/Chicago")
+
+    private fun at(h: Int, m: Int, s: Int, day: Int = 15, month: Int = 6) =
+        ClockFormat.at(central, 2026, month, day, h, m, s)
+
+    private fun show24(millis: Long) = ClockFormat.render(true, millis, central)
+    private fun show12(millis: Long) = ClockFormat.render(false, millis, central)
+
+    @Test
+    fun alwaysSixDigits() {
+        for (hour in 0..23) {
+            val t = at(hour, 4, 5)
+            assertEquals("24h hour $hour", 8, show24(t).length)
+            assertEquals("12h hour $hour", 8, show12(t).length)
+        }
+    }
+
+    @Test
+    fun twentyFourHourNeverReachesTwentyFour() {
+        assertEquals("00:00:00", show24(at(0, 0, 0)))
+        assertEquals("23:59:59", show24(at(23, 59, 59)))
+        for (hour in 0..23) {
+            val rendered = show24(at(hour, 30, 0))
+            val hh = rendered.substring(0, 2).toInt()
+            assertEquals("hour $hour", hour, hh)
+            assert(hh in 0..23) { "24h rendered $rendered" }
+        }
+    }
+
+    @Test
+    fun midnightRollover() {
+        assertEquals("23:59:59", show24(at(23, 59, 59)))
+        assertEquals("00:00:00", show24(at(23, 59, 59) + 1_000L))
+        assertEquals("11:59:59", show12(at(23, 59, 59)))
+        assertEquals("12:00:00", show12(at(23, 59, 59) + 1_000L))
+    }
+
+    @Test
+    fun noonRollover() {
+        assertEquals("11:59:59", show12(at(11, 59, 59)))
+        assertEquals("12:00:00", show12(at(12, 0, 0)))
+        assertEquals("12:59:59", show12(at(12, 59, 59)))
+        assertEquals("01:00:00", show12(at(13, 0, 0)))
+        assertEquals("12:59:59", show24(at(12, 59, 59)))
+        assertEquals("13:00:00", show24(at(13, 0, 0)))
+    }
+
+    @Test
+    fun twelveHourShowsTwelveNotZeroAtBothTwelves() {
+        assertEquals("12:00:00", show12(at(0, 0, 0)))
+        assertEquals("12:00:00", show12(at(12, 0, 0)))
+    }
+
+    /** 2026-03-08: 01:59:59 CST -> 03:00:00 CDT. The 02:00 hour does not exist. */
+    @Test
+    fun dstSpringForwardSkipsTheMissingHour() {
+        val beforeJump = ClockFormat.at(central, 2026, 3, 8, 1, 59, 59)
+        assertEquals("01:59:59", show24(beforeJump))
+        assertEquals("03:00:00", show24(beforeJump + 1_000L))
+        assertEquals("03:00:00", show12(beforeJump + 1_000L))
+    }
+
+    /**
+     * 2026-11-01: 01:59:59 CDT -> 01:00:00 CST, so the 01:00 hour happens twice.
+     * Anchored at 00:30, which is unambiguous - a local 01:30 on this date is not,
+     * and Calendar resolves it to the second (standard-time) occurrence.
+     */
+    @Test
+    fun dstFallBackRepeatsTheHourWithoutExceedingRange() {
+        val start = ClockFormat.at(central, 2026, 11, 1, 0, 30, 0)
+        assertEquals("00:30:00", show24(start))
+        assertEquals("01:30:00", show24(start + 3_600_000L))
+        assertEquals("01:30:00", show24(start + 2 * 3_600_000L))
+        assertEquals("02:30:00", show24(start + 3 * 3_600_000L))
+    }
+
+    /** A DST shift must not push the 24h clock past 23, the old elapsed-based bug. */
+    @Test
+    fun dstDaysStayWithinRange() {
+        for (date in listOf(Triple(2026, 3, 8), Triple(2026, 11, 1))) {
+            val (y, mo, d) = date
+            var t = ClockFormat.at(central, y, mo, d, 0, 0, 0)
+            val end = t + 26 * 3_600_000L
+            while (t < end) {
+                val hh = show24(t).substring(0, 2).toInt()
+                assert(hh in 0..23) { "24h hour out of range on $y-$mo-$d: ${show24(t)}" }
+                val h12 = show12(t).substring(0, 2).toInt()
+                assert(h12 in 1..12) { "12h hour out of range on $y-$mo-$d: ${show12(t)}" }
+                t += 7 * 60_000L
+            }
+        }
+    }
+
+    @Test
+    fun patternsAreTheOnesTextClockNeeds() {
+        assertEquals("HH:mm:ss", ClockFormat.pattern(true))
+        assertEquals("hh:mm:ss", ClockFormat.pattern(false))
+    }
+}
